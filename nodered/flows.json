    },
    {
        "id": "func_db",
        "type": "function",
        "z": "tab_vib",
        "name": "组装 INSERT 参数",
        "func": "var d = msg.payload;\nif (typeof d === 'string') { try { d = JSON.parse(d); } catch (e) { return null; } }\nif (!d || d.rms === undefined) { return null; }\n// 优先使用设备上报的测量时刻（NTP，Unix 秒），保证补发的历史数据位置正确；\n// 设备未对时则回退为接收时刻。\nvar t;\nif (d.ts && Number(d.ts) > 1600000000) {\n  t = new Date(Number(d.ts) * 1000);\n} else {\n  t = new Date();\n}\nvar tv = (d.temp !== undefined && d.temp !== null) ? d.temp : d.tchip;\nmsg.params = [ t.toISOString(), d.node || 'unknown', d.rms, tv, d.state ];\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 400,
        "y": 400,
        "wires": [
            [
                "sqlite_insert"
            ]
        ]
    },
    {
        "id": "sqlite_insert",
        "type": "sqlite",
        "z": "tab_vib",
        "name": "写入历史",
        "mydb": "sqlite_db_1",
        "sqlquery": "prepared",
        "sql": "INSERT INTO readings (ts, node, rms, temp, state) VALUES (?, ?, ?, ?, ?)",
        "x": 630,
        "y": 400,
        "wires": [
            []
        ]
    },
