    {
        "id": "sqlite_query",
        "type": "sqlite",
        "z": "tab_vib",
        "name": "查询最近 200 条",
        "mydb": "sqlite_db_1",
        "sqlquery": "prepared",
        "sql": "SELECT ts, rms FROM readings ORDER BY id DESC LIMIT 200",
        "x": 620,
