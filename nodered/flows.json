    {
        "id": "func_1",
        "type": "function",
        "z": "tab_vib",
        "name": "拆分字段",
        "func": "var d = msg.payload;\nif (typeof d === 'string') { try { d = JSON.parse(d); } catch (e) { return null; } }\nif (!d || d.rms === undefined) { return null; }\n// 温度优先用 DS18B20 表面温度，未接入时回退到 MPU6050 芯片温度\nvar tv = (d.temp !== undefined && d.temp !== null) ? d.temp : d.tchip;\nreturn [\n  { payload: d.rms },\n  { payload: tv },\n  { payload: d.state },\n  { payload: d.rms, topic: 'RMS' }\n];",
        "outputs": 4,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 380,
        "y": 40,
        "wires": [
            [
                "gauge_rms"
            ],
            [
                "gauge_temp"
            ],
            [
                "text_state"
            ],
            [
                "chart_rms"
            ]
        ]
    },
