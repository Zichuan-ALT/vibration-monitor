            ]
        ]
    },
    {
        "id": "func_chart",
        "type": "function",
        "z": "tab_vib",
        "name": "转成曲线数据",
        "func": "// 逐条送入（与实时图相同的单点路径，已验证可用）。\n// 关键：图表节点的 removeOlder 必须足够大，否则客户端会立刻丢弃历史点。\nvar rows = msg.payload;\nif (!Array.isArray(rows) || rows.length === 0) { return null; }\nrows = rows.slice().reverse();\nvar out = [{ payload: [] }];\nfor (var i = 0; i < rows.length; i++) {\n  out.push({ payload: rows[i].rms, timestamp: Date.parse(rows[i].ts) });\n}\nreturn [out];\n",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 820,
        "y": 520,
        "wires": [
            [
                "chart_hist"
            ]
        ]
    },
