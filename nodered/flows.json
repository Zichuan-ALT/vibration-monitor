    {
        "id": "func_alarm",
        "type": "function",
        "z": "tab_vib",
        "name": "状态映射（来自设备）",
        "func": "var d = msg.payload;\nif (typeof d === 'string') { try { d = JSON.parse(d); } catch (e) { return null; } }\nif (!d) { return null; }\n\nvar s = d.state || 'normal';\nvar LEVEL = { normal: '正常', warn: '注意', alarm: '报警', uncalibrated: '未标定' };\nvar ADVICE = {\n  normal: '运行正常，继续保持监测',\n  warn:   '振动偏高：建议检查地脚螺栓与紧固件',\n  alarm:  '振动异常：建议停机检查动平衡与轴承',\n  uncalibrated: '基线未建立：请让设备正常运转后重新学习'\n};\n\nreturn [\n  { payload: LEVEL[s] || s },\n  { payload: ADVICE[s] || '' },\n  { payload: s }\n];",
        "outputs": 3,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 400,
        "y": 160,
        "wires": [
            [
                "text_alarm"
            ],
            [
                "text_advice"
            ],
            []
        ]
